<Window x:Class="Floppy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floppy" Height="760" Width="1180" MinHeight="560" MinWidth="980"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="OnFocusSearch"/>
    </Window.CommandBindings>
    <Window.Resources>
        <DataTemplate x:Key="GameTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="48" CornerRadius="5" Background="{StaticResource BgRowHover}">
                    <Grid>
                        <Path Data="M 2,5 L 10,5 13,8 13,15 11,17 8,13 5,13 2,17 0,15 0,8 Z M 3,9 L 7,9 M 5,7 L 5,11 M 10,9 L 11,9"
                              Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.2"/>
                        <Border CornerRadius="5">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding CoverPath}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Status}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="verbunden">
                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Border x:Name="LibraryPane" Grid.RowSpan="4" Background="{StaticResource BgTief}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="14,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentDim}" Margin="0,0,11,0">
                        <Path Width="21" Height="21" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                              Data="M 3,1 L 17,1 21,5 21,21 1,21 1,1 Z M 6,1 L 6,8 16,8 16,1 M 5,21 L 5,13 17,13 17,21 M 13,3 L 13,6"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Floppy" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock Text="Deine Spiele. Deine Optionen." FontSize="9.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="1" Margin="8,4,4,12">
                    <TextBlock Text="Bibliothek" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Button x:Name="RescanButton" Content="↻" ToolTip="Spiele neu suchen"
                            AutomationProperties.Name="Spiele neu suchen" HorizontalAlignment="Right"
                            Style="{StaticResource GhostButton}" Padding="8,3" FontSize="18" Click="OnRescanLibrary"/>
                </Grid>
                <ListBox x:Name="GameList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ItemTemplate="{StaticResource GameTemplate}" ItemContainerStyle="{StaticResource NavItem}"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnGameSelected"/>
                <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="8,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="LibraryHint" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="Floppy · Modmenü" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="HeaderPanel" Grid.Column="1" Grid.ColumnSpan="2" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Dein Spiel" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                <TextBlock x:Name="SelectedGameTitle" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Text="{Binding SelectedItem.Name, ElementName=GameList, TargetNullValue=Deine Bibliothek, FallbackValue=Deine Bibliothek}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="LaunchButton" Content="Spiel starten" Style="{StaticResource FlatButton}"
                        Margin="0,0,8,0" Click="OnLaunchGame"/>
                <Button x:Name="ConnectButton" Content="Verbinden" MinWidth="104"
                        Style="{StaticResource AccentButton}" Click="OnConnectClicked"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1"
                Background="{StaticResource BgPanel}" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                         Margin="0,0,22,0" TextChanged="OnSearchChanged" AutomationProperties.Name="Funktionen durchsuchen"/>
                <WrapPanel x:Name="HeaderActions" Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="AllOffButton" Content="Alles aus" Style="{StaticResource GhostButton}"
                            ToolTip="Alle rücksetzbaren Optionen auf ihre Normalwerte setzen" Margin="0,0,8,0" Click="OnAllOff"/>
                    <Button x:Name="ToolsButton" Content="Werkzeuge  ···" Style="{StaticResource FlatButton}" Click="OnToolsClicked">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Diagnose anzeigen" Click="OnDiagnose"/>
                                <MenuItem Header="Floppy einrichten / reparieren" Click="OnRepair"/>
                                <MenuItem Header="Installation wiederherstellen" Click="OnRestore"/>
                                <Separator/>
                                <MenuItem Header="Spielordner wählen…" Click="OnChooseGameFolder"/>
                                <MenuItem Header="Automatische Ordnersuche verwenden" Click="OnAutomaticGameFolder"/>
                                <MenuItem Header="Profilordner öffnen" Click="OnOpenProfiles"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Border x:Name="CategoriesPane" Grid.Row="2" Grid.Column="1" Padding="14,22,10,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Funktionen" FontSize="11" Foreground="{StaticResource Muted}" Margin="10,0,0,16"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CategoryList"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="OptionsPane" Grid.Row="2" Grid.Column="2" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,18,24,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding Text, ElementName=GameLabel, StringFormat=Verbindung: {0}}"
                                   FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PaneTitle" Text="Bereit, wenn du es bist" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="PaneCount" Grid.Column="1" Text="" VerticalAlignment="Center"
                               FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="OptionsPanel"/>
                </ScrollViewer>
                <StackPanel x:Name="EmptyHint" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Margin="12">
                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource AccentDim}" Margin="0,0,0,22">
                        <Path Width="28" Height="28" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.4"
                              Data="M 3,1 L 17,1 21,5 21,21 1,21 1,1 Z M 6,1 L 6,8 16,8 16,1 M 5,21 L 5,13 17,13 17,21"/>
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="Dein nächstes Spiel wartet" FontSize="20" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="EmptyBody" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="13" LineHeight="21" Foreground="{StaticResource Muted}"
                               Text="Wähle links ein Spiel aus. Sobald es verbunden ist, findest du hier alle verfügbaren Optionen."/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="SessionBar" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,8,0" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusLabel" Grid.Column="1" Text="Wähle ein Spiel aus deiner Bibliothek" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource Muted}"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock x:Name="GameLabel" Text="nicht verbunden" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,0,14,0" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="F1  Menü" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Muted}" ToolTip="Öffnet das Menü, sofern vom Spielmodul unterstützt."/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
