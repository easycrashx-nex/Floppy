<Window x:Class="Floppy.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen · Floppy" Width="700" Height="790" MinWidth="570" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SettingsHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,14,0"/>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="28,24,28,20">
            <TextBlock Text="Dein Floppy" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
            <TextBlock Text="Einstellungen" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="Für die App und alle deine Spiele." Style="{StaticResource SettingsHint}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,0,28,8">
            <StackPanel>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Start &amp; Fenster" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
                        <CheckBox x:Name="AutoConnectToggle" Style="{StaticResource SwitchToggle}" AutomationProperties.Name="Automatisch verbinden">
                            <StackPanel>
                                <TextBlock Text="Automatisch verbinden" TextWrapping="Wrap"/>
                                <TextBlock Text="Verbindet Floppy mit einem laufenden unterstützten Spiel." Style="{StaticResource SettingsHint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,17"/>
                        <CheckBox x:Name="StartMinimizedToggle" Style="{StaticResource SwitchToggle}" AutomationProperties.Name="Minimiert starten">
                            <StackPanel>
                                <TextBlock Text="Minimiert starten" TextWrapping="Wrap"/>
                                <TextBlock Text="Beim nächsten Start bleibt Floppy in der Taskleiste." Style="{StaticResource SettingsHint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,17"/>
                        <CheckBox x:Name="RememberWindowToggle" Style="{StaticResource SwitchToggle}" AutomationProperties.Name="Fensterposition merken">
                            <StackPanel>
                                <TextBlock Text="Fensterposition merken" TextWrapping="Wrap"/>
                                <TextBlock Text="Stellt Größe und Position beim nächsten Start wieder her." Style="{StaticResource SettingsHint}"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Overlay-Taste" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Öffnet das Menü im Spiel. Esc führt zurück zum Spiel." Style="{StaticResource SettingsHint}"/>
                        </StackPanel>
                        <ComboBox x:Name="OverlayHotkeyChoice" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Overlay-Taste"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold"/>
                            <Border Grid.Column="1" Background="{StaticResource AccentDim}" CornerRadius="5" Padding="9,4">
                                <TextBlock x:Name="VersionLabel" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Accent}"/>
                            </Border>
                        </Grid>
                        <CheckBox x:Name="CheckUpdatesToggle" Style="{StaticResource SwitchToggle}" AutomationProperties.Name="Beim Start nach Updates suchen">
                            <StackPanel>
                                <TextBlock Text="Beim Start nach Updates suchen" TextWrapping="Wrap"/>
                                <TextBlock Text="Prüft neue Versionen auf GitHub. Du entscheidest über die Installation." Style="{StaticResource SettingsHint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Background="{StaticResource BgSenke}" CornerRadius="7" Padding="12" Margin="0,18,0,12">
                            <StackPanel>
                                <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" FontSize="12" LineHeight="18"/>
                                <ProgressBar x:Name="UpdateProgress" Height="5" Minimum="0" Maximum="1" Visibility="Collapsed"
                                             Margin="0,10,0,0" Background="{StaticResource BgRow}" Foreground="{StaticResource Accent}"
                                             AutomationProperties.Name="Updatefortschritt">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Grid><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,0,-8,0">
                            <Button x:Name="CheckUpdatesButton" Content="Nach Updates suchen" Style="{StaticResource FlatButton}" Click="OnCheckUpdates" Margin="0,0,8,8"/>
                            <Button x:Name="DownloadUpdateButton" Content="Herunterladen und neu starten" Style="{StaticResource AccentButton}" Click="OnDownloadUpdate" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <Button x:Name="ReleasesButton" Content="Releaseverlauf ↗" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0,5" Click="OnOpenReleases"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource BgTief}" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatus" Text="Änderungen mit Speichern übernehmen." Foreground="{StaticResource Muted}" FontSize="11.5"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CloseSettingsButton" Content="Schließen" Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="OnClose"/>
                    <Button x:Name="SaveSettingsButton" Content="Speichern" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnSave"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
