<UserControl x:Class="Floppy.App.ItemPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Floppy.App">
    <UserControl.Resources>
        <local:ItemImageConverter x:Key="ItemImage"/>
        <local:ItemCategoryIconConverter x:Key="CategoryIcon"/>
        <DataTemplate x:Key="ItemThumbnail">
            <Grid Width="40" Height="40" Margin="0,0,12,0">
                <Border x:Name="FallbackBadge" Background="{StaticResource BgSenke}" CornerRadius="8"
                        ToolTip="Kategoriesymbol · kein Itembild verfügbar">
                    <Path x:Name="ItemFallback" Data="{Binding Category, Converter={StaticResource CategoryIcon}}"
                          Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource Accent}"
                          StrokeThickness="1.5" StrokeLineJoin="Round"/>
                </Border>
                <Image x:Name="ItemIcon" Source="{Binding IconPath, Converter={StaticResource ItemImage}}"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IconPath, Converter={StaticResource ItemImage}}" Value="{x:Null}">
                    <Setter TargetName="ItemIcon" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=ItemIcon}" Value="Visible">
                    <Setter TargetName="FallbackBadge" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ItemRow">
            <Grid ToolTip="{Binding Id}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemThumbnail}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style x:Key="ItemListRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Face" Background="Transparent" CornerRadius="7"
                            BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource BgRowHover}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource AccentDim}"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Gegenstand auswählen" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>
        <TextBlock Text="Kategorie" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
        <ComboBox x:Name="CategoryFilter" DisplayMemberPath="Label" SelectedValuePath="Name"
                  AutomationProperties.Name="Itemkategorie" MaxDropDownHeight="340"/>
        <Grid Margin="0,8,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="ItemSearch" AutomationProperties.Name="Gegenstände durchsuchen" Padding="11,8" Height="36"/>
                <TextBlock Text="Itemname suchen …" Foreground="{StaticResource Muted}" Margin="12,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ItemSearch}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button x:Name="ClearSearch" Grid.Column="1" Content="×" Width="32" Margin="6,0,0,0" Padding="0"
                    Style="{StaticResource GhostButton}" ToolTip="Itemsuche leeren" AutomationProperties.Name="Itemsuche leeren"/>
        </Grid>
        <TextBlock x:Name="ResultCount" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
        <Border Background="{StaticResource BgSenke}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="2">
            <Grid>
                <ListBox x:Name="ItemList" Height="168" Background="Transparent" BorderThickness="0"
                         ItemTemplate="{StaticResource ItemRow}" ItemContainerStyle="{StaticResource ItemListRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionMode="Single" AutomationProperties.Name="Gegenstände"/>
                <StackPanel x:Name="NoResults" Visibility="Collapsed" VerticalAlignment="Center" Margin="14">
                    <TextBlock Text="Keine passenden Gegenstände" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Andere Kategorie wählen oder Suche anpassen." Foreground="{StaticResource Muted}"
                               TextAlignment="Center" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Background="{StaticResource AccentDim}" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ContentControl x:Name="SelectedPreview" ContentTemplate="{StaticResource ItemThumbnail}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionHint" Text="Für das Inventar ausgewählt" Foreground="{StaticResource Accent}" FontSize="10.5" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SelectedItemName" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
